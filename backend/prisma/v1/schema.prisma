  eventType       String              @map("event_type") @db.VarChar(100)
  payload         Json
  signatureValid  Boolean             @map("signature_valid")
  status          ProviderEventStatus @default(RECEIVED)
  receivedAt      DateTime            @default(now()) @map("received_at") @db.Timestamptz(6)
  processedAt     DateTime?           @map("processed_at") @db.Timestamptz(6)
  payment         Payment?            @relation(fields: [organizationId, paymentId], references: [organizationId, id], onDelete: Restrict)

  @@unique([provider, providerEventId])
  @@index([organizationId, status, receivedAt])
  @@map("payment_provider_events")
}

model Vendor {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String       @db.VarChar(40)
  name           String       @db.VarChar(200)
  status         RecordStatus @default(ACTIVE)
  expenses       Expense[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("vendors")
}

model Expense {
  id                     String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String              @map("organization_id") @db.Uuid
  branchId               String              @map("branch_id") @db.Uuid
  expenseNumber          String              @map("expense_number") @db.VarChar(60)
  status                 ExpenseStatus       @default(DRAFT)
  expenseDate            DateTime            @map("expense_date") @db.Date
  vendorId               String?             @map("vendor_id") @db.Uuid
  currencyId             String              @map("currency_id") @db.Uuid
  subtotal               Decimal             @db.Decimal(19, 4)
  tax                    Decimal             @default(0) @db.Decimal(19, 4)
  total                  Decimal             @db.Decimal(19, 4)
  description            String              @db.VarChar(1000)
  createdByMembershipId  String              @map("created_by_membership_id") @db.Uuid
  approvedByMembershipId String?             @map("approved_by_membership_id") @db.Uuid
  approvedAt             DateTime?           @map("approved_at") @db.Timestamptz(6)
  postedAt               DateTime?           @map("posted_at") @db.Timestamptz(6)
  journalEntryId         String?             @map("journal_entry_id") @db.Uuid
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch                 Branch              @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  vendor                 Vendor?             @relation(fields: [organizationId, vendorId], references: [organizationId, id], onDelete: Restrict)
  currency               Currency            @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  allocations            PaymentAllocation[]

  @@unique([organizationId, expenseNumber])
  @@unique([organizationId, id])
  @@index([organizationId, branchId, expenseDate])
  @@index([organizationId, status])
  @@map("expenses")
}

model Account {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String             @map("organization_id") @db.Uuid
  code             String             @db.VarChar(40)
  name             String             @db.VarChar(200)
  type             AccountType
  parentId         String?            @map("parent_id") @db.Uuid
  isControlAccount Boolean            @default(false) @map("is_control_account")
  status           RecordStatus       @default(ACTIVE)
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent           Account?           @relation("AccountHierarchy", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict)
  children         Account[]          @relation("AccountHierarchy")
  journalLines     JournalEntryLine[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, type, status])
  @@map("accounts")
}

model FiscalPeriod {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  fiscalYear     Int                @map("fiscal_year")
  periodNumber   Int                @map("period_number")
  startsAt       DateTime           @map("starts_at") @db.Date
  endsAt         DateTime           @map("ends_at") @db.Date
  status         FiscalPeriodStatus @default(OPEN)
  closedAt       DateTime?          @map("closed_at") @db.Timestamptz(6)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entries        JournalEntry[]

  @@unique([organizationId, fiscalYear, periodNumber])
  @@unique([organizationId, id])
  @@index([organizationId, status, startsAt, endsAt])
  @@map("fiscal_periods")
}

model Journal {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  code           String         @db.VarChar(40)
  name           String         @db.VarChar(160)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  entries        JournalEntry[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@map("journals")
}

model JournalEntry {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String             @map("organization_id") @db.Uuid
  journalId            String             @map("journal_id") @db.Uuid
  fiscalPeriodId       String             @map("fiscal_period_id") @db.Uuid
  entryNumber          String             @map("entry_number") @db.VarChar(60)
  entryDate            DateTime           @map("entry_date") @db.Date
  sourceType           String             @map("source_type") @db.VarChar(80)
  sourceId             String             @map("source_id") @db.Uuid
  currencyId           String             @map("currency_id") @db.Uuid
  status               JournalEntryStatus @default(DRAFT)
  description          String             @db.VarChar(1000)
  reversalOfId         String?            @map("reversal_of_id") @db.Uuid
  postedByMembershipId String?            @map("posted_by_membership_id") @db.Uuid
  postedAt             DateTime?          @map("posted_at") @db.Timestamptz(6)
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  journal              Journal            @relation(fields: [organizationId, journalId], references: [organizationId, id], onDelete: Restrict)
  fiscalPeriod         FiscalPeriod       @relation(fields: [organizationId, fiscalPeriodId], references: [organizationId, id], onDelete: Restrict)
  currency             Currency           @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  reversalOf           JournalEntry?      @relation("EntryReversal", fields: [organizationId, reversalOfId], references: [organizationId, id], onDelete: Restrict)
  reversedBy           JournalEntry?      @relation("EntryReversal")
  lines                JournalEntryLine[]

  @@unique([organizationId, entryNumber])
  @@unique([organizationId, sourceType, sourceId])
  @@unique([organizationId, reversalOfId])
  @@unique([organizationId, id])
  @@index([organizationId, fiscalPeriodId, entryDate])
  @@index([organizationId, status])
  @@map("journal_entries")
}

model JournalEntryLine {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  journalEntryId String       @map("journal_entry_id") @db.Uuid
  lineNumber     Int          @map("line_number")
  accountId      String       @map("account_id") @db.Uuid
  debit          Decimal      @default(0) @db.Decimal(19, 4)
  credit         Decimal      @default(0) @db.Decimal(19, 4)
  currencyId     String       @map("currency_id") @db.Uuid
  description    String?      @db.VarChar(500)
  entry          JournalEntry @relation(fields: [organizationId, journalEntryId], references: [organizationId, id], onDelete: Restrict)
  account        Account      @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)
  currency       Currency     @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@unique([journalEntryId, lineNumber])
  @@index([accountId, journalEntryId])
  @@map("journal_entry_lines")
}

model Adjustment {
  id                     String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String           @map("organization_id") @db.Uuid
  sourceType             String           @map("source_type") @db.VarChar(80)
  sourceId               String           @map("source_id") @db.Uuid
  reason                 String           @db.VarChar(1000)
  status                 AdjustmentStatus @default(DRAFT)
  createdByMembershipId  String           @map("created_by_membership_id") @db.Uuid
  approvedByMembershipId String?          @map("approved_by_membership_id") @db.Uuid
  journalEntryId         String?          @map("journal_entry_id") @db.Uuid
  createdAt              DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([organizationId, sourceType, sourceId, id])
  @@index([organizationId, status, createdAt])
  @@map("adjustments")
}

model AuditLog {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  actorMembershipId String?  @map("actor_membership_id") @db.Uuid
  action            String   @db.VarChar(120)
  entityType        String   @map("entity_type") @db.VarChar(120)
  entityId          String?  @map("entity_id") @db.Uuid
  requestId         String   @map("request_id") @db.VarChar(100)
  ipAddress         String?  @map("ip_address") @db.Inet
  userAgent         String?  @map("user_agent") @db.Text
  beforeJson        Json?    @map("before_json")
  afterJson         Json?    @map("after_json")
  metadataJson      Json?    @map("metadata_json")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([actorMembershipId, createdAt])
  @@index([requestId])
  @@map("audit_logs")
}

model IdempotencyKey {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  endpoint       String            @db.VarChar(200)
  key            String            @db.VarChar(200)
  requestHash    String            @map("request_hash") @db.VarChar(128)
  status         IdempotencyStatus @default(PROCESSING)
  responseStatus Int?              @map("response_status")
  responseBody   Json?             @map("response_body")
  resourceType   String?           @map("resource_type") @db.VarChar(100)
  resourceId     String?           @map("resource_id") @db.Uuid
  lockedAt       DateTime?         @map("locked_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(6)

  @@unique([organizationId, endpoint, key])
  @@index([status, expiresAt])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  eventType        String       @map("event_type") @db.VarChar(160)
  aggregateType    String       @map("aggregate_type") @db.VarChar(120)
  aggregateId      String       @map("aggregate_id") @db.Uuid
  aggregateVersion Int          @map("aggregate_version")
  payload          Json
  status           OutboxStatus @default(PENDING)
  attempts         Int          @default(0)
  availableAt      DateTime     @default(now()) @map("available_at") @db.Timestamptz(6)
  lockedAt         DateTime?    @map("locked_at") @db.Timestamptz(6)
  lockedBy         String?      @map("locked_by") @db.VarChar(120)
  lastError        String?      @map("last_error") @db.Text
  processedAt      DateTime?    @map("processed_at") @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([organizationId, aggregateType, aggregateId, aggregateVersion, eventType])
  @@index([status, availableAt, lockedAt])
  @@index([aggregateType, aggregateId, createdAt])
  @@map("outbox_events")
}

model NumberSequence {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  branchId       String?             @map("branch_id") @db.Uuid
  code           String              @db.VarChar(60)
  scope          NumberSequenceScope @default(ORGANIZATION)
  prefix         String?             @db.VarChar(30)
  nextValue      BigInt              @default(1) @map("next_value")
  padding        Int                 @default(6)
  version        Int                 @default(0)
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, branchId, code])
  @@index([organizationId, code])
  @@map("number_sequences")
}
