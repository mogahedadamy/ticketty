// Ticketty Database Contract v1.0 — candidate schema
// IMPORTANT: This is a validation candidate. prisma.config.ts still points to ../schema.prisma.
// SQL-only checks, exclusion constraints, immutability triggers, and RLS live in ./sql/.

generator client {
  provider = "prisma-client-js"
  output   = "../../generated/v1-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RecordStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REVOKED
}

enum RoleScope {
  SYSTEM
  TENANT
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SeatType {
  REGULAR
  VIP
  ACCESSIBLE
  CREW
  BLOCKED
}

enum BusStatus {
  READY
  MAINTENANCE
  OUT_OF_SERVICE
  ARCHIVED
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum TripStatus {
  DRAFT
  SCHEDULED
  BOARDING
  DEPARTED
  COMPLETED
  CANCELLED
}

enum TripSeatStatus {
  AVAILABLE
  HELD
  SOLD
  BLOCKED
}

enum HoldStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  RELEASED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PARTIALLY_CANCELLED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum BookingItemStatus {
  RESERVED
  CONFIRMED
  CANCELLED
  REFUNDED
  USED
}

enum TicketStatus {
  ISSUED
  CHECKED_IN
  USED
  CANCELLED
  REFUNDED
  EXPIRED
}

enum TicketEventType {
  ISSUED
  REPRINTED
  CHECKED_IN
  USED
  CANCELLED
  REFUNDED
  EXPIRED
  OVERRIDE
}

enum BoardingEventType {
  CHECK_IN
  CHECK_IN_REJECTED
  OVERRIDE
  BOARDING_REVERSED
}

enum ManifestStatus {
  OPEN
  LOCKED
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum CommissionRuleType {
  FIXED
  PERCENTAGE
}

enum AgentTransactionType {
  SALE
  COMMISSION
  PAYMENT
  REFUND
  ADJUSTMENT
  SETTLEMENT
  REVERSAL
}

enum SettlementStatus {
  DRAFT
  APPROVED
  POSTED
  CANCELLED
}

enum PaymentPayerType {
  CUSTOMER
  AGENT
  ORGANIZATION
  OTHER
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  BANKAK
  MTN_MOMO
  ZAIN_CASH
  OTHER
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  COMPLETED
  FAILED
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

enum AllocationTargetType {
  BOOKING
  AGENT_SETTLEMENT
  EXPENSE
  OTHER
}

enum RefundStatus {
  PENDING
  APPROVED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  REJECTED
  CANCELLED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum FiscalPeriodStatus {
  OPEN
  CLOSING
  CLOSED
}

enum JournalEntryStatus {
  DRAFT
  POSTED
  REVERSED
}

enum AdjustmentStatus {
  DRAFT
  APPROVED
  POSTED
  REJECTED
  CANCELLED
}

enum IdempotencyStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

enum ProviderEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

enum NumberSequenceScope {
  ORGANIZATION
  BRANCH
}

model Currency {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String             @unique @db.VarChar(3)
  name           String             @db.VarChar(100)
  minorUnits     Int                @default(2)
  active         Boolean            @default(true)
  organizations  Organization[]
  trips          Trip[]
  bookings       Booking[]
  agents         Agent[]
  agentTxns      AgentTransaction[]
  settlements    AgentSettlement[]
  payments       Payment[]
  refunds        Refund[]
  expenses       Expense[]
  tripSeats      TripSeat[]
  tickets        Ticket[]
  journalEntries JournalEntry[]
  journalLines   JournalEntryLine[]

  @@map("currencies")
}

model Organization {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String                   @unique @db.VarChar(40)
  legalName         String                   @map("legal_name") @db.VarChar(200)
  displayName       String                   @map("display_name") @db.VarChar(200)
  status            RecordStatus             @default(ACTIVE)
  defaultCurrencyId String                   @map("default_currency_id") @db.Uuid
  timezone          String                   @db.VarChar(64)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  defaultCurrency   Currency                 @relation(fields: [defaultCurrencyId], references: [id])
  branches          Branch[]
  memberships       OrganizationMembership[]
  roles             Role[]
  stations          Station[]
  routes            Route[]
  seatLayouts       SeatLayout[]
  busModels         BusModel[]
  buses             Bus[]
  drivers           Driver[]
  trips             Trip[]
  passengers        Passenger[]
  customers         Customer[]
  bookings          Booking[]
  agents            Agent[]
  payments          Payment[]
  expenses          Expense[]
  accounts          Account[]
  fiscalPeriods     FiscalPeriod[]
  journals          Journal[]
  fileAssets        FileAsset[]
  numberSequences   NumberSequence[]

  @@map("organizations")
}

model Branch {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String             @map("organization_id") @db.Uuid
  code             String             @db.VarChar(40)
  name             String             @db.VarChar(160)
  status           RecordStatus       @default(ACTIVE)
  timezone         String             @db.VarChar(64)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membershipScopes MembershipBranch[]
  buses            Bus[]
  drivers          Driver[]
  trips            Trip[]
  bookings         Booking[]
  agents           Agent[]
  payments         Payment[]
  expenses         Expense[]
  manifests        Manifest[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("branches")
}

model User {
  id           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String                   @unique @db.VarChar(320)
  phone        String?                  @db.VarChar(32)
  passwordHash String                   @map("password_hash") @db.VarChar(255)
  status       RecordStatus             @default(ACTIVE)
  lastLoginAt  DateTime?                @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships  OrganizationMembership[]

  @@map("users")
}

model OrganizationMembership {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  status         MembershipStatus   @default(ACTIVE)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  branches       MembershipBranch[]
  roles          MembershipRole[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId, status])
  @@map("organization_memberships")
}

model MembershipBranch {
  organizationId String                 @map("organization_id") @db.Uuid
  membershipId   String                 @map("membership_id") @db.Uuid
  branchId       String                 @map("branch_id") @db.Uuid
  membership     OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  branch         Branch                 @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Cascade)

  @@id([membershipId, branchId])
  @@index([organizationId, branchId])
  @@map("membership_branches")
}

model Role {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?          @map("organization_id") @db.Uuid
  scope          RoleScope
  code           String           @db.VarChar(80)
  name           String           @db.VarChar(160)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  permissions    RolePermission[]
  memberships    MembershipRole[]

  @@unique([organizationId, code])
  @@index([scope, code])
  @@map("roles")
}

model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique @db.VarChar(120)
  description String           @db.VarChar(500)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  organizationId String?    @map("organization_id") @db.Uuid
  roleId         String     @map("role_id") @db.Uuid
  permissionId   String     @map("permission_id") @db.Uuid
  role           Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission     Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([organizationId, roleId])
  @@map("role_permissions")
}

model MembershipRole {
  organizationId String                 @map("organization_id") @db.Uuid
  membershipId   String                 @map("membership_id") @db.Uuid
  roleId         String                 @map("role_id") @db.Uuid
  membership     OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  role           Role                   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([membershipId, roleId])
  @@index([organizationId, roleId])
  @@map("membership_roles")
}

model Station {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  code              String       @db.VarChar(40)
  name              String       @db.VarChar(160)
  city              String       @db.VarChar(120)
  address           String?      @db.VarChar(500)
  latitude          Decimal?     @db.Decimal(9, 6)
  longitude         Decimal?     @db.Decimal(9, 6)
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  originRoutes      Route[]      @relation("RouteOrigin")
  destinationRoutes Route[]      @relation("RouteDestination")
  routeStops        RouteStop[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("stations")
}

model Route {
  id                       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String       @map("organization_id") @db.Uuid
  code                     String       @db.VarChar(40)
  name                     String       @db.VarChar(200)
  originStationId          String       @map("origin_station_id") @db.Uuid
  destinationStationId     String       @map("destination_station_id") @db.Uuid
  distanceKm               Decimal?     @map("distance_km") @db.Decimal(10, 2)
  estimatedDurationMinutes Int?         @map("estimated_duration_minutes")
  status                   RecordStatus @default(ACTIVE)
  createdAt                DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization             Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  originStation            Station      @relation("RouteOrigin", fields: [organizationId, originStationId], references: [organizationId, id], onDelete: Restrict)
  destinationStation       Station      @relation("RouteDestination", fields: [organizationId, destinationStationId], references: [organizationId, id], onDelete: Restrict)
  stops                    RouteStop[]
  trips                    Trip[]

  @@unique([organizationId, code])
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("routes")
}

model RouteStop {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String   @map("organization_id") @db.Uuid
  routeId                String   @map("route_id") @db.Uuid
  stationId              String   @map("station_id") @db.Uuid
  sequence               Int
  arrivalOffsetMinutes   Int?     @map("arrival_offset_minutes")
  departureOffsetMinutes Int?     @map("departure_offset_minutes")
  distanceFromOriginKm   Decimal? @map("distance_from_origin_km") @db.Decimal(10, 2)
  route                  Route    @relation(fields: [organizationId, routeId], references: [organizationId, id], onDelete: Cascade)
  station                Station  @relation(fields: [organizationId, stationId], references: [organizationId, id], onDelete: Restrict)

  @@unique([routeId, sequence])
  @@unique([routeId, stationId])
  @@index([organizationId, stationId])
  @@map("route_stops")
}

model SeatLayout {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  name           String           @db.VarChar(160)
  layoutType     String           @map("layout_type") @db.VarChar(40)
  version        Int
  status         AssetStatus      @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  seats          SeatDefinition[]
  busModels      BusModel[]
  trips          Trip[]

  @@unique([organizationId, name, version])
  @@unique([organizationId, id])
  @@map("seat_layouts")
}

model SeatDefinition {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  seatLayoutId   String     @map("seat_layout_id") @db.Uuid
  seatCode       String     @map("seat_code") @db.VarChar(20)
  rowNumber      Int        @map("row_number")
  columnNumber   Int        @map("column_number")
  position       String?    @db.VarChar(40)
  seatType       SeatType   @default(REGULAR) @map("seat_type")
  layout         SeatLayout @relation(fields: [organizationId, seatLayoutId], references: [organizationId, id], onDelete: Cascade)
  tripSeats      TripSeat[]

  @@unique([seatLayoutId, seatCode])
  @@unique([organizationId, id])
  @@index([seatLayoutId, rowNumber, columnNumber])
  @@map("seat_definitions")
}

model BusModel {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  manufacturer   String       @db.VarChar(120)
  model          String       @db.VarChar(120)
  seatLayoutId   String       @map("seat_layout_id") @db.Uuid
  status         AssetStatus  @default(ACTIVE)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  seatLayout     SeatLayout   @relation(fields: [organizationId, seatLayoutId], references: [organizationId, id], onDelete: Restrict)
  buses          Bus[]

  @@unique([organizationId, manufacturer, model, seatLayoutId])
  @@unique([organizationId, id])
  @@map("bus_models")
}

model Bus {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  branchId           String       @map("branch_id") @db.Uuid
  busModelId         String       @map("bus_model_id") @db.Uuid
  code               String       @db.VarChar(40)
  registrationNumber String       @map("registration_number") @db.VarChar(80)
  status             BusStatus    @default(READY)
  licenseExpiry      DateTime?    @map("license_expiry") @db.Date
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch             Branch       @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  busModel           BusModel     @relation(fields: [organizationId, busModelId], references: [organizationId, id], onDelete: Restrict)
  trips              Trip[]

  @@unique([organizationId, code])
  @@unique([organizationId, registrationNumber])
  @@unique([organizationId, id])
  @@index([organizationId, branchId, status])
  @@map("buses")
}

model Driver {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  branchId       String           @map("branch_id") @db.Uuid
  employeeCode   String           @map("employee_code") @db.VarChar(40)
  firstName      String           @map("first_name") @db.VarChar(100)
  lastName       String           @map("last_name") @db.VarChar(100)
  phone          String?          @db.VarChar(32)
  status         DriverStatus     @default(ACTIVE)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch         Branch           @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  documents      DriverDocument[]
  trips          Trip[]

  @@unique([organizationId, employeeCode])
  @@unique([organizationId, id])
  @@index([organizationId, branchId, status])
  @@map("drivers")
}

model FileAsset {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String           @map("organization_id") @db.Uuid
  storageProvider String           @map("storage_provider") @db.VarChar(40)
  objectKey       String           @map("object_key") @db.VarChar(1024)
  filename        String           @db.VarChar(255)
  mimeType        String           @map("mime_type") @db.VarChar(160)
  sizeBytes       BigInt           @map("size_bytes")
  checksum        String           @db.VarChar(128)
  encrypted       Boolean          @default(false)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  driverDocuments DriverDocument[]

  @@unique([organizationId, objectKey])
  @@unique([organizationId, id])
  @@map("file_assets")
}

model DriverDocument {
  id                       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String      @map("organization_id") @db.Uuid
  driverId                 String      @map("driver_id") @db.Uuid
  documentType             String      @map("document_type") @db.VarChar(60)
  documentNumberEncrypted  Bytes       @map("document_number_encrypted")
  documentNumberBlindIndex String      @map("document_number_blind_index") @db.VarChar(128)
  issuedAt                 DateTime?   @map("issued_at") @db.Date
  expiresAt                DateTime?   @map("expires_at") @db.Date
  fileAssetId              String?     @map("file_asset_id") @db.Uuid
  status                   AssetStatus @default(ACTIVE)
  driver                   Driver      @relation(fields: [organizationId, driverId], references: [organizationId, id], onDelete: Restrict)
  fileAsset                FileAsset?  @relation(fields: [organizationId, fileAssetId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, documentType, documentNumberBlindIndex])
  @@index([driverId, expiresAt])
  @@map("driver_documents")
}

model Trip {
  id                   String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String          @map("organization_id") @db.Uuid
  branchId             String          @map("branch_id") @db.Uuid
  routeId              String          @map("route_id") @db.Uuid
  serviceDate          DateTime        @map("service_date") @db.Date
  scheduledDepartureAt DateTime        @map("scheduled_departure_at") @db.Timestamptz(6)
  scheduledArrivalAt   DateTime        @map("scheduled_arrival_at") @db.Timestamptz(6)
  actualDepartureAt    DateTime?       @map("actual_departure_at") @db.Timestamptz(6)
  actualArrivalAt      DateTime?       @map("actual_arrival_at") @db.Timestamptz(6)
  status               TripStatus      @default(DRAFT)
  currencyId           String          @map("currency_id") @db.Uuid
  baseFare             Decimal         @map("base_fare") @db.Decimal(19, 4)
  busId                String?         @map("bus_id") @db.Uuid
  driverId             String?         @map("driver_id") @db.Uuid
  seatLayoutId         String          @map("seat_layout_id") @db.Uuid
  version              Int             @default(0)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization         Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch               Branch          @relation(fields: [organizationId, branchId], references: [organizationId, id], onDelete: Restrict)
  route                Route           @relation(fields: [organizationId, routeId], references: [organizationId, id], onDelete: Restrict)
  currency             Currency        @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  bus                  Bus?            @relation(fields: [organizationId, busId], references: [organizationId, id], onDelete: Restrict)
  driver               Driver?         @relation(fields: [organizationId, driverId], references: [organizationId, id], onDelete: Restrict)
  seatLayout           SeatLayout      @relation(fields: [organizationId, seatLayoutId], references: [organizationId, id], onDelete: Restrict)
  seats                TripSeat[]
  bookings             Booking[]
  manifests            Manifest[]
  boardingEvents       BoardingEvent[]

  @@unique([organizationId, id])
  @@index([organizationId, serviceDate])
  @@index([organizationId, branchId, serviceDate])
  @@index([organizationId, status])
  @@index([routeId, serviceDate])
  @@index([busId, scheduledDepartureAt])
  @@index([driverId, scheduledDepartureAt])
  @@map("trips")
}

model TripSeat {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  tripId           String         @map("trip_id") @db.Uuid
  seatDefinitionId String         @map("seat_definition_id") @db.Uuid
  seatCode         String         @map("seat_code") @db.VarChar(20)
  rowNumber        Int            @map("row_number")
  columnNumber     Int            @map("column_number")
  seatType         SeatType       @map("seat_type")
  status           TripSeatStatus @default(AVAILABLE)
  fare             Decimal        @db.Decimal(19, 4)
  currencyId       String         @map("currency_id") @db.Uuid
  holdExpiresAt    DateTime?      @map("hold_expires_at") @db.Timestamptz(6)
  version          Int            @default(0)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  trip             Trip           @relation(fields: [organizationId, tripId], references: [organizationId, id], onDelete: Cascade)
  seatDefinition   SeatDefinition @relation(fields: [organizationId, seatDefinitionId], references: [organizationId, id], onDelete: Restrict)
  currency         Currency       @relation(fields: [currencyId], references: [id], onDelete: Restrict)
  holds            SeatHold[]
  bookingItems     BookingItem[]

  @@unique([tripId, seatDefinitionId])
  @@unique([tripId, seatCode])
  @@unique([tripId, rowNumber, columnNumber])
  @@unique([organizationId, id])
  @@index([tripId, status])
